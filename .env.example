# =============================================================================
# Ingressos — variáveis de ambiente
# Copie para .env.local (desenvolvimento). NUNCA versione valores reais.
# Referência completa: docs/08-deploy.md
# =============================================================================

# --- Público (exposto ao navegador) ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Chave pública Ed25519 usada na verificação offline do QR Code (Sprint 4/7)
NEXT_PUBLIC_TICKET_PUBLIC_KEY=""

# --- Servidor ----------------------------------------------------------------
# Nunca deve chegar ao bundle do cliente
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- E-mail transacional (Resend) — Sprint 5 ---------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Ingressos <nao-responda@seudominio.com.br>"

# --- WhatsApp — API oficial da Meta (docs/09-whatsapp-escala.md) ---------------
# Opcionais: quando definidas, têm precedência sobre o que foi salvo em
# Configurações → WhatsApp. Nunca coloque valores reais neste arquivo.
META_ACCESS_TOKEN=""
META_APP_SECRET=""
META_PHONE_NUMBER_ID=""
META_VERIFY_TOKEN=""
# Versão da Graph API (formato vNN.N). Sem valor: v23.0.
META_GRAPH_VERSION="v23.0"

# --- Worker do WhatsApp (processo separado, PM2: ingressos-whatsapp) ----------
# Usa DATABASE_URL (no Supabase: pooler em modo SESSÃO, porta 5432) e
# NEXT_PUBLIC_APP_URL (link do QR do ingresso).
WORKER_ID=""
# CA do Supabase (Database → SSL Configuration), para verificar o certificado
# do banco. Sem ela o worker NÃO sobe, a menos que DATABASE_SSL_INSECURE=1.
DATABASE_SSL_CA=""
DATABASE_SSL_INSECURE=""

# --- Testes de integração e carga — SEMPRE o Supabase local -------------------
# Os testes recusam qualquer host que não seja localhost.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Integrações — sprints futuras -------------------------------------------
GEOCODING_API_KEY=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Operação ----------------------------------------------------------------
# Segredo do webhook de invalidação de ISR disparado pelo banco
REVALIDATE_SECRET=""
SENTRY_DSN=""
NODE_ENV="development"

# =============================================================================
# Ingressos — variáveis de ambiente
# Copie para .env.local (desenvolvimento). NUNCA versione valores reais.
# Referência completa: docs/08-deploy.md
# =============================================================================

# --- Público (exposto ao navegador) ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Chave pública Ed25519 usada na verificação offline do QR Code (Sprint 4/7)
NEXT_PUBLIC_TICKET_PUBLIC_KEY=""

# --- Servidor ----------------------------------------------------------------
# Nunca deve chegar ao bundle do cliente
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- E-mail transacional (Resend) — Sprint 5 ---------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Ingressos <nao-responda@seudominio.com.br>"

# --- Integrações — sprints futuras -------------------------------------------
GEOCODING_API_KEY=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Operação ----------------------------------------------------------------
# Segredo do webhook de invalidação de ISR disparado pelo banco
REVALIDATE_SECRET=""
SENTRY_DSN=""
NODE_ENV="development"
